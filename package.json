{
  "name": "buckl",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "lint": "npm run lint -w web",
    "typecheck": "npm run typecheck -w web",
    "test": "npm run test -w web",
    "build": "npm run build -w web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6"
  }
}
