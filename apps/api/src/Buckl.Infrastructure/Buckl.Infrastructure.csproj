<Project Sdk="Microsoft.NET.Sdk">
  <!-- Infrastructure layer: adapters that implement the application's ports. -->
  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- Referenced explicitly so every project resolves EF Core 10.0.12: Npgsql's provider only
         asks for 10.0.4 and the mismatch with the Design package fails the build (MSB3277). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Buckl.Application/Buckl.Application.csproj" />
  </ItemGroup>
</Project>
