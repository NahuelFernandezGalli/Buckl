# The API's settings as environment variables, the way a host or `docker run --env-file` passes
# them (phase 9). The API does not read .env files: locally, set the same keys with
# `dotnet user-secrets`, writing ":" instead of "__" (see apps/api/README.md). Never commit values.

ASPNETCORE_ENVIRONMENT=Production

# Secret. Application role (buckl_app), never the owner.
ConnectionStrings__Buckl=

# Not secret, but per environment.
Auth0__Domain=
Auth0__Audience=https://api.buckl.app

# One variable per web app origin: scheme and host, no trailing slash.
Cors__AllowedOrigins__0=

# Secret. Owner role, only while applying migrations; the API never reads it.
BUCKL_MIGRATIONS_CONNECTION=
