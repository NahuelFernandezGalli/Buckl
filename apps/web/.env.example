# Copy to apps/web/.env.local (ignored by git) and fill in. Every value here ends up in the public
# bundle: none of them is a secret. Vite reads them when it starts or builds.

# Auth0 tenant domain, without https://
VITE_AUTH0_DOMAIN=
# Client ID of the "Buckl Web" single-page application in Auth0
VITE_AUTH0_CLIENT_ID=
# Identifier of the "Buckl API" registered in Auth0
VITE_AUTH0_AUDIENCE=https://api.buckl.app
# Where the API listens. Must be https:// unless the host is localhost, 127.0.0.1 or [::1].
VITE_API_BASE_URL=http://localhost:5080
